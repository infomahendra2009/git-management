{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Start Quiz Portal frontend",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"run",
				"dev",
				"--",
				"--host",
				"127.0.0.1"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Start Quiz Portal frontend with npm.cmd",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"--prefix",
				"frontend",
				"run",
				"dev",
				"--",
				"--host",
				"127.0.0.1"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Start Quiz Portal Docker Compose",
			"type": "shell",
			"command": "docker",
			"args": [
				"compose",
				"up",
				"-d",
				"--build"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check Quiz Portal compose status",
			"type": "shell",
			"command": "docker",
			"args": [
				"compose",
				"ps"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Run backend tests",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"--prefix",
				"backend",
				"test"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Build Quiz Portal frontend",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"--prefix",
				"frontend",
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Verify deployed feature assets",
			"type": "shell",
			"command": "docker",
			"args": [
				"compose",
				"exec",
				"-T",
				"web",
				"sh",
				"-c",
				"grep -o 'Bulk create students from CSV' /usr/share/nginx/html/assets/*.js >/dev/null && echo frontend-updated || echo frontend-old; docker compose exec -T api grep -q \"bulk-status\" /app/src/routes/users.js && echo api-updated || echo api-old"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Verify API bulk routes in container",
			"type": "shell",
			"command": "docker",
			"args": [
				"compose",
				"exec",
				"-T",
				"api",
				"grep",
				"-n",
				"bulk-status",
				"/app/src/routes/users.js"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}